services:
  - type: web
    name: jusoor-accounting
    env: node
    buildCommand: npm install && npm rebuild better-sqlite3 --force
    startCommand: npm start
    envVars:
      - key: NODE_VERSION
        value: 20.18.0
      - key: NODE_ENV
        value: production
      - key: JWT_SECRET
        generateValue: true
      - key: BCRYPT_SALT_ROUNDS
        value: 12
      - key: JWT_EXPIRES_IN
        value: 7d
