# ============================================
# أونكس برو - نموذج متغيرات البيئة
# ⚠️ انسخ هذا الملف إلى .env وأدخل بياناتك الحقيقية
# ⚠️ لا ترفع ملف .env إلى GitHub أبداً!
# ============================================

# ===== بيانات تسجيل الدخول =====
# اسم المستخدم الافتراضي (يمكنك تغييره)
ADMIN_USERNAME=admin
# كلمة المرور الافتراضية (يجب تغييرها)
ADMIN_PASSWORD=admin123

# ===== إعدادات البوت =====
# 🔴 مهم: احصل على رمز البوت من @BotFather على تليجرام
# مثال: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_telegram_bot_token_here

# اسم المستخدم الخاص بالبوت (بدون @)
# مثال: MyAccountingBot
BOT_USERNAME=your_bot_username_here

# معرف الدردشة الخاص بك (احصل عليه من @userinfobot)
# مثال: 123456789
ADMIN_CHAT_ID=your_telegram_chat_id_here

# ===== مفاتيح التشفير =====
# مفتاح تشفير قوي (32 حرف على الأقل)
# يمكنك توليده عشوائياً
ENCRYPTION_KEY=your_secure_encryption_key_32_characters_here

# مفتاح الجلسة
SESSION_SECRET=your_session_secret_key_here

# ===== إعدادات النظام =====
# العملة الافتراضية (SAR, USD, EUR, YER)
DEFAULT_CURRENCY=SAR

# اللغة الافتراضية (ar, en)
DEFAULT_LANG=ar

# المنطقة الزمنية
TZ=Asia/Riyadh

# ===== إعدادات البث المباشر =====
# تمكين البث المباشر (true/false)
ENABLE_STREAM=true

# جودة البث (low/medium/high)
STREAM_QUALITY=medium

# ===== إعدادات النسخ الاحتياطي =====
# تمكين النسخ الاحتياطي التلقائي (true/false)
AUTO_BACKUP=true

# فترة النسخ الاحتياطي (بالساعات)
BACKUP_INTERVAL=2

# ===== إعدادات الأمان =====
# عدد محاولات الدخول المسموح بها
MAX_LOGIN_ATTEMPTS=5

# مدة الحظر بعد المحاولات الفاشلة (بالدقائق)
BLOCK_DURATION=15

# تمكين التوثيق الثنائي (true/false)
TWO_FACTOR_AUTH=false

# ===== إعدادات التطبيق =====
# اسم التطبيق
APP_NAME=أونكس برو

# إصدار التطبيق
APP_VERSION=9.0

# بيئة التشغيل (development/production)
NODE_ENV=production

# المنفذ (لـ Render)
PORT=3000
