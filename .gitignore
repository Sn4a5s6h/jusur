# ============================================
# .gitignore - أونكس برو
# ⚠️ هذا الملف يمنع رفع الملفات الحساسة
# ============================================

# 🔴 الملفات الحساسة - لا ترفعها أبداً!
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
*.env
*.env.*
secrets/
keys/
certificates/
*.pem
*.key
*.crt

# ملفات Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ملفات التطبيق
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ملفات البناء
dist/
build/
public/
out/
.vercel/
.netlify/

# ملفات التخزين المحلي
*.db
*.sqlite
*.sqlite3
storage/
uploads/
temp/

# ملفات البيئة المشفرة
.env.encrypted
.env.crypt
*.encrypted
*.crypt

# ملفات النسخ الاحتياطي
backup-*.json
*.backup
*.bak

# ملفات السجلات
logs/
*.log

# ملفات البث
streams/
recordings/
snapshots/
videos/
audio/

# ملفات IDE
.vscode/
.idea/
*.iml

# ملفات النظام
.DS_Store
Thumbs.db
desktop.ini

# ملفات الاختبار
coverage/
.nyc_output/
test-results/

# ملفات مؤقتة
*.tmp
*.temp
*.cache
